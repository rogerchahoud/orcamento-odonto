# PostgreSQL — conexão usada em dev/testes e produção (Neon).
# O `neon env pull` grava essas duas variáveis apontando para a branch atual.
DATABASE_URL=postgresql://<user>:<senha>@<host>-pooler.<region>.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://<user>:<senha>@<host>.<region>.aws.neon.tech/neondb?sslmode=require

# Neon Auth (Managed Better Auth) — injetadas pelo `neon deploy` quando `auth: true` em neon.ts.
NEON_AUTH_BASE_URL=https://<branch>-<hash>.neon.tech/auth

# Segredo das sessões/cookies (não é injetado pela Neon).
# Gere com: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=
